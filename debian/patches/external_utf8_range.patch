+++ b/third_party/utf8_range/CMakeLists.txt
@@ -7,7 +7,7 @@ if (POLICY CMP0077)
 endif (POLICY CMP0077)
 
 option (utf8_range_ENABLE_TESTS "Build test suite" ON)
